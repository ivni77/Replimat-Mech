	<!-- Childhood of a person printed by the bioreplicator, the only mark on the character card: title and a one-line hover
	     (Patch_BackstoryDescription); no skill gains, no disabled work; no adulthood (vanilla gives none before 20) -->
	<BackstoryDef>
		<defName>RM_Bioreplicated</defName>
		<title>replicant</title>
		<titleShort>replicant</titleShort>
		<description>Printed in a bioreplicator.</description>
		<slot>Childhood</slot>
		<shuffleable>false</shuffleable>
	</BackstoryDef>

	<!-- Mark of a creature printed by the bioreplicator: whole body, no effects; shown on animals, hidden on people, where it keeps
	     the template value (the market value floor, Patch_PawnValue) -->
	<HediffDef>
		<defName>RM_Replicant</defName>
		<label>replicant</label>
		<description>A creature printed by a bioreplicator.</description>
		<hediffClass>ReplimatMech.Hediff_RMReplicant</hediffClass>
		<isBad>false</isBad>
		<everCurableByItem>false</everCurableByItem>
	</HediffDef>

</Defs>
